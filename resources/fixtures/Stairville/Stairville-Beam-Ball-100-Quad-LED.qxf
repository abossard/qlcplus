<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE FixtureDefinition>
<FixtureDefinition xmlns="http://www.qlcplus.org/FixtureDefinition">
 <Creator>
  <Name>Q Light Controller Plus</Name>
  <Version>5.0.0 Beta 3</Version>
  <Author>André Bossard</Author>
 </Creator>
 <Manufacturer>Stairville</Manufacturer>
 <Model>Beam Ball 100 Quad LED</Model>
 <Type>Moving Head</Type>
 <Channel Name="Pan" Preset="PositionPan"/>
 <Channel Name="Pan Fine" Preset="PositionPanFine"/>
 <Channel Name="Tilt">
  <Group Byte="0">Tilt</Group>
  <Capability Min="0" Max="191">Fixed position</Capability>
  <Capability Min="192" Max="222" Preset="RotationClockwiseFastToSlow">Endless rotation CW, fast to slow</Capability>
  <Capability Min="223" Max="224" Preset="RotationStop">Stop</Capability>
  <Capability Min="225" Max="255" Preset="RotationCounterClockwiseSlowToFast">Endless rotation CCW, slow to fast</Capability>
 </Channel>
 <Channel Name="Tilt Fine" Preset="PositionTiltFine"/>
 <Channel Name="Pan/Tilt Speed" Preset="SpeedPanTiltSlowFast"/>
 <Channel Name="Master Dimmer" Preset="IntensityMasterDimmer"/>
 <Channel Name="Strobe">
  <Group Byte="0">Shutter</Group>
  <Capability Min="0" Max="9" Preset="ShutterOpen">No function</Capability>
  <Capability Min="10" Max="255" Preset="StrobeSlowToFast">Strobe effect, slow to fast</Capability>
 </Channel>
 <Channel Name="Scenes/Programmes">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="49">No function</Capability>
  <Capability Min="50" Max="59" Preset="ColorMacro" Res1="#ff0000">Red</Capability>
  <Capability Min="60" Max="69" Preset="ColorMacro" Res1="#00ff00">Green</Capability>
  <Capability Min="70" Max="79" Preset="ColorMacro" Res1="#0000ff">Blue</Capability>
  <Capability Min="80" Max="89" Preset="ColorMacro" Res1="#ffffff">White</Capability>
  <Capability Min="90" Max="99" Preset="ColorMacro" Res1="#ffff00">Yellow</Capability>
  <Capability Min="100" Max="109" Preset="ColorMacro" Res1="#00ffff">Cyan</Capability>
  <Capability Min="110" Max="119" Preset="ColorMacro" Res1="#ff00ff">Pink</Capability>
  <Capability Min="120" Max="129" Preset="ColorMacro" Res1="#ffffff">All LEDs white</Capability>
  <Capability Min="130" Max="139">Not used</Capability>
  <Capability Min="140" Max="149">Programme 1</Capability>
  <Capability Min="150" Max="159">Programme 2</Capability>
  <Capability Min="160" Max="169">Programme 3</Capability>
  <Capability Min="170" Max="179">Programme 4</Capability>
  <Capability Min="180" Max="233">Not used</Capability>
  <Capability Min="234" Max="236" Preset="ResetAll">Reset</Capability>
  <Capability Min="237" Max="249">Not used</Capability>
  <Capability Min="250" Max="255">Sound control</Capability>
 </Channel>
 <Channel Name="Microphone Sensitivity">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Sensitivity of the built-in microphone</Capability>
 </Channel>
 <!-- 11-Channel mode: master RGBW -->
 <Channel Name="Red" Preset="IntensityRed"/>
 <Channel Name="Green" Preset="IntensityGreen"/>
 <Channel Name="Blue" Preset="IntensityBlue"/>
 <Channel Name="White" Preset="IntensityWhite"/>
 <!-- 15-Channel mode: Side A RGBW -->
 <Channel Name="Red Side A" Preset="IntensityRed"/>
 <Channel Name="Green Side A" Preset="IntensityGreen"/>
 <Channel Name="Blue Side A" Preset="IntensityBlue"/>
 <Channel Name="White Side A" Preset="IntensityWhite"/>
 <!-- 15-Channel mode: Side B RGBW -->
 <Channel Name="Red Side B" Preset="IntensityRed"/>
 <Channel Name="Green Side B" Preset="IntensityGreen"/>
 <Channel Name="Blue Side B" Preset="IntensityBlue"/>
 <Channel Name="White Side B" Preset="IntensityWhite"/>
 <!-- 49-Channel mode: per-LED RGBW -->
 <Channel Name="Red LED 1" Preset="IntensityRed"/>
 <Channel Name="Green LED 1" Preset="IntensityGreen"/>
 <Channel Name="Blue LED 1" Preset="IntensityBlue"/>
 <Channel Name="White LED 1" Preset="IntensityWhite"/>
