  <Function ID="28" Type="Script" Name="R3-BassPunch" Version="2">
   <Speed FadeIn="0" FadeOut="0" Duration="0"/>
   <Direction>Forward</Direction>
   <RunOrder>Loop</RunOrder>
   <Command></Command>
   <Command>var%20brightness%20%3D%200%3B</Command>
   <Command>var%20decay%20%3D%200.92%3B</Command>
   <Command>for%20%28var%20tick%20%3D%200%3B%20tick%20%3C%202000%3B%20tick%2B%2B%29%20%7B</Command>
   <Command>%20%20%20%20var%20bass%20%3D%20Engine.getAudioFrequency%280%2C%203%29%3B</Command>
   <Command>%20%20%20%20</Command>
   <Command>%20%20%20%20%2F%2F%20Fast%20attack%3A%20if%20bass%20is%20louder%20than%20current%20brightness%2C%20jump%20up</Command>
   <Command>%20%20%20%20if%20%28bass%20%3E%20brightness%29%20%7B</Command>
   <Command>%20%20%20%20%20%20%20%20brightness%20%3D%20bass%3B</Command>
   <Command>%20%20%20%20%7D%20else%20%7B</Command>
   <Command>%20%20%20%20%20%20%20%20%2F%2F%20Slow%20decay</Command>
   <Command>%20%20%20%20%20%20%20%20brightness%20%3D%20brightness%20%2A%20decay%3B</Command>
   <Command>%20%20%20%20%7D</Command>
   <Command>%20%20%20%20</Command>
   <Command>%20%20%20%20var%20dim%20%3D%20Math.round%28brightness%29%3B</Command>
   <Command>%20%20%20%20</Command>
   <Command>%20%20%20%20%2F%2F%20Apply%20to%20all%20fixtures%20dimmer-style%20%28white%20channel%20for%20extra%20punch%29</Command>
   <Command>%20%20%20%20for%20%28var%20fxi%20%3D%200%3B%20fxi%20%3C%204%3B%20fxi%2B%2B%29%20%7B</Command>
   <Command>%20%20%20%20%20%20%20%20for%20%28var%20px%20%3D%200%3B%20px%20%3C%2080%3B%20px%2B%2B%29%20%7B</Command>
   <Command>%20%20%20%20%20%20%20%20%20%20%20%20Engine.setFixture%28fxi%2C%20px%20%2A%204%20%2B%203%2C%20dim%29%3B%20%20%2F%2F%20W%20channel</Command>
   <Command>%20%20%20%20%20%20%20%20%7D</Command>
   <Command>%20%20%20%20%7D</Command>
   <Command>%20%20%20%20Engine.waitTime%2825%29%3B</Command>
   <Command>%7D</Command>
  </Function>
